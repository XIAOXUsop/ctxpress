<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.xiaoxusop</groupId>
    <artifactId>ctxpress-parent</artifactId>
    <version>0.4.4</version>
    <packaging>pom</packaging>

    <name>ctxpress</name>
    <!--
      措辞是刻意收窄的。"关键信息零丢失"这种说法对 JSON 数组不成立，
      而且与"塞进 N 个 token"在数学上互斥（预算不够时二者只能取一）。
      下面这三句都是可离线断言的事实：命中保护规则的按构造保留；
      未保护部分可经内容寻址归档逐字节取回；输出不含原文没有的内容。
    -->
    <description>Agent 上下文压缩引擎：在工具输出/日志/RAG 片段进入 LLM 前做确定性、可审计、可逆的压缩，并保证输出不超过给定 token 预算（做不到时如实声明）</description>
    <url>https://github.com/XIAOXUsop/ctxpress</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>XIAOXUsop</id>
            <name>XIAOXUsop</name>
            <url>https://github.com/XIAOXUsop</url>
        </developer>
    </developers>

    <!-- Central 要求 SCM 指向可访问的仓库；tag 与 POM 版本一致才能通过校验 -->
    <scm>
        <connection>scm:git:https://github.com/XIAOXUsop/ctxpress.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/XIAOXUsop/ctxpress.git</developerConnection>
        <url>https://github.com/XIAOXUsop/ctxpress</url>
        <tag>v${project.version}</tag>
    </scm>

    <modules>
        <module>ctxpress-core</module>
        <module>ctxpress-cli</module>
        <module>ctxpress-tokenizer-jtokkit</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.13.4</junit.version>
        <!--
          2.21.5 而不是 2.19.0：2.19.0 命中 5 条 jackson-databind 公告，
          逐条查过 NVD 的受影响区间后，要求的最高修复版本是 2.21.5：

            CVE-2026-54512  多态类型校验器绕过          修复 2.21.4
            CVE-2026-54513  数组子类型白名单绕过         修复 2.21.4
            CVE-2026-54514  InetSocketAddress 触发即时 DNS 解析  修复 2.21.4
            CVE-2026-54515  逐属性大小写不敏感的反序列化绕过  修复 2.21.5
            CVE-2026-59888  Record 上的 @JsonIgnore 被绕过      修复 2.21.4
            （五条都落在 `2.19.0 ≤ v < 2.21.4/2.21.5` 这个分支上）

          ⚠️ **这个依赖此前不在任何告警视野里**，值得说清楚为什么：
          ctxpress 是多模块工程，`jackson.version` 定义在父 pom、由子模块引用，
          而 GitHub 的依赖图对 Maven 是静态解析的——它解析不出跨模块的属性，
          于是在依赖图里记成了 `com.fasterxml.jackson.core:jackson-databind`
          **不带版本号**。Dependabot 拿不到版本就无法与公告的版本区间比对，
          所以这个仓库的 Security 页一直是 0 条告警。
          （实测：ctxpress 8 个坐标里 2 个没版本号；单模块、版本写在同一份 pom 里的
          mcp-sentinel 是 0/5，而它是唯一拿到过告警的那个仓库。）

          本项目的 `JsonCompressor` 只用 `ObjectMapper` / `JsonNode`，没开多态类型，
          所以那两条 HIGH 未必可达；但这只是一次补丁级升级，不值得为此赌一把。
        -->
        <jackson.version>2.21.5</jackson.version>
        <!--
          可复现构建：固定产物里每个条目的时间戳。
          这个仓库把 jar 发到 GitHub Release，不固定的话同一份源码在不同时刻
          构建出的字节不同，「下载到的 jar 是不是从这份源码构建的」就无法用哈希回答。
          实测（加之前）：连续两次 `./mvnw clean package -DskipTests` 的 sha256 不同。
        -->
        <project.build.outputTimestamp>2026-09-19T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              构建前的环境校验。加它是因为一次真实的困惑：本机 Maven 3.3.9 跑 `mvn package`
              会撞上 maven-compiler-plugin 报的 "requires Maven version 3.6.3" —— 一句话里
              提到的两个版本号都不是根因（根因是本地 mvn 太旧），排查成本远高于在这里早说一句。
              README 里的 `./mvnw package` 路径不受影响，wrapper 自带 3.9.x。
            -->
            <!--
              把 LICENSE 打进每个模块 jar 的 META-INF。
              Maven 默认不这么做，于是发布的库产物里没有许可证文本——
              一个可自由再分发的 jar 必须自带它的许可条件。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-license-into-jar</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <!--
                                      多模块项目：LICENSE 在仓库根，而每个模块的
                                      ${project.basedir} 是模块自己那一层——直接用它会找不到文件，
                                      而且**不会报错**（copy-resources 对空目录是静默通过）。
                                    -->
                                    <directory>${project.basedir}/..</directory>
                                    <includes>
                                        <include>LICENSE</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.6.3,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              让发布出去的 POM 自包含。

              ── 为什么需要它 ──────────────────────────────────────────────
              子模块的 POM 继承自 ctxpress-parent，`jackson.version` 这类属性也定义在
              父 POM 里。而 jar 内嵌的 META-INF/maven/**/pom.xml 就是这份**未经解析**
              的 POM，`mvn install:install-file` 会优先用它——于是使用者照 README
              从 Release 装完之后，宿主工程解析 ctxpress-core 时会去找
              ctxpress-parent:pom:0.4.1，找不到就整个构建失败。

              实测（2026-09-18）：照 README 那两步做完，一个最小示例工程报
              "Could not find artifact io.github.xiaoxusop:ctxpress-parent:pom:0.4.1"。
              也就是说那条路径当时**根本走不通**，而 README 写着它是唯一能装上的方式。

              flatten 把父 POM 的继承与属性解析进一份自包含的 POM，install / deploy
              用的就是它。对 Maven Central 同样是必需的：Central 期望的也是自包含 POM。
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <!-- oss：去掉 parent、解析属性与继承，保留 license / scm / developers -->
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          发布到 Maven Central 用的 profile。**默认不参与构建**：
          签名需要 GPG 私钥，源码 / Javadoc jar 也会拖慢日常迭代。

          用法：mvn -Prelease -DskipTests deploy
          凭据来自 settings.xml 里 id=central 的 server（Sonatype 用户令牌）。
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <!-- 注释里有中文与代码片段，doclint 的严格模式会让发布卡在文档格式上 -->
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.9.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <!-- 与 settings.xml 里 <server><id>central</id> 对应 -->
                            <publishingServerId>central</publishingServerId>
                            <!-- 先传到 Portal 停在待发布状态，确认无误再点发布 -->
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>